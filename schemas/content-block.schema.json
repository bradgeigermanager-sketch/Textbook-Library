{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Typed Content Block",
  "type": "object",
  "required": [
    "block_id",
    "parent_node_id",
    "block_type",
    "order",
    "source"
  ],
  "properties": {
    "block_id": {
      "type": "string"
    },
    "parent_node_id": {
      "type": "string"
    },
    "block_type": {
      "enum": [
        "paragraph",
        "heading",
        "equation",
        "code",
        "figure",
        "table",
        "list",
        "quote",
        "callout",
        "exercise",
        "definition",
        "theorem",
        "proof",
        "citation_marker",
        "raw_html",
        "unknown"
      ]
    },
    "order": {
      "type": "integer",
      "minimum": 0
    },
    "text": {
      "type": [
        "string",
        "null"
      ]
    },
    "raw_source": {
      "type": [
        "string",
        "null"
      ]
    },
    "language": {
      "type": [
        "string",
        "null"
      ]
    },
    "math_format": {
      "type": [
        "string",
        "null"
      ]
    },
    "caption": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line_start": {
          "type": [
            "integer",
            "null"
          ]
        },
        "line_end": {
          "type": [
            "integer",
            "null"
          ]
        },
        "page": {
          "type": [
            "integer",
            "null"
          ]
        },
        "anchor": {
          "type": [
            "string",
            "null"
          ]
        },
        "content_sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "extraction": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string"
        },
        "parser_name": {
          "type": "string"
        },
        "parser_version": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": false
}

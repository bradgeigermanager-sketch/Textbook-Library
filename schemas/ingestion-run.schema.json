{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ingestion Run",
  "type": "object",
  "required": [
    "run_id",
    "resource_id",
    "started_at",
    "pipeline_version",
    "status"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "resource_id": {
      "type": "string"
    },
    "manifest_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "pipeline_version": {
      "type": "string"
    },
    "adapter_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "started",
        "completed",
        "completed_with_warnings",
        "failed",
        "quarantined"
      ]
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "output_digest": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}

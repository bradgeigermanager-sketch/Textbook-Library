{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Textbook Identity",
  "type": "object",
  "required": [
    "textbook_id",
    "title",
    "resource_id",
    "identity_status"
  ],
  "properties": {
    "textbook_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "resource_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": [
        "string",
        "null"
      ]
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "editors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "identifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scheme": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "scheme",
          "value"
        ]
      }
    },
    "identity_status": {
      "enum": [
        "provisional",
        "matched",
        "confirmed",
        "merged",
        "disputed"
      ]
    },
    "same_work_as": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
